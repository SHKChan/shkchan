---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title = 'SHK Chan · Vibe Gaming Lab',
  description = 'Tech notes on game mechanics, C++ GUI, computer vision and full-stack engineering.',
  keywords = [],
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0e0f1d" />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a href={`${base}/`} class="brand" aria-label="SHK Chan home">
          <svg viewBox="0 0 10 10" aria-hidden="true" shape-rendering="crispEdges">
            <rect x="0" y="3" width="10" height="5" fill="#7ee08a" />
            <rect x="1" y="2" width="8" height="1" fill="#7ee08a" />
            <rect x="1" y="8" width="2" height="1" fill="#7ee08a" />
            <rect x="7" y="8" width="2" height="1" fill="#7ee08a" />
            <rect x="2" y="4" width="1" height="3" fill="#0e0f1d" />
            <rect x="1" y="5" width="3" height="1" fill="#0e0f1d" />
            <rect x="6" y="4" width="1" height="1" fill="#ff6f9c" />
            <rect x="8" y="5" width="1" height="1" fill="#ffd45e" />
          </svg>
          <span>
            <span class="pixel brand-name">SHK.LAB</span>
            <span class="brand-tag">Vibe gaming · C++ GUI · Vision · Full-stack</span>
          </span>
        </a>
        <nav class="nav">
          <a href={`${base}/`} class="btn">Posts</a>
          <a href="https://www.vibe-game.com/" class="btn btn-ghost">Games</a>
          <a href="https://github.com/SHKChan" class="btn btn-ghost" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer pixel">
        © {new Date().getFullYear()} SHK Chan · Built with Astro
      </footer>
    </div>
  </body>
</html>
