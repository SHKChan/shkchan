---
import BaseLayout from './BaseLayout.astro';
import { type Post, base, formatDate, categoryUrl, tagUrl, readingMinutes } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, category, tags } = post.data;
---

<BaseLayout title={`${title} · SHK Chan`} description={description} keywords={[category, ...tags]}>
  <article>
    <header class="post-head">
      <a href={`${base}/`} class="back pixel">◀ Back to quest log</a>
      <div class="quest-meta pixel">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <a href={categoryUrl(category)} class="cat">{category}</a>
        <span>{readingMinutes(post.body)} min read</span>
        {updated && <span>Updated {formatDate(updated)}</span>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    <div class="prose panel">
      <slot />
    </div>

    <footer class="post-foot">
      <a href={`${base}/`} class="btn btn-ghost">◀ All posts</a>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <a href={tagUrl(tag)} class="chip">#{tag}</a>)}
        </div>
      )}
    </footer>
  </article>
</BaseLayout>
