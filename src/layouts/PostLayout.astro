---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${frontmatter.title} · SHK Chan`} description={frontmatter.description}>
  <article>
    <header class="post-head">
      <a href={`${base}/`} class="back pixel">◀ Back to quest log</a>
      <div class="quest-meta pixel">
        <time datetime={frontmatter.date}>{frontmatter.date}</time>
        {frontmatter.category && <span class="cat">{frontmatter.category}</span>}
      </div>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="lede">{frontmatter.description}</p>}
    </header>

    <div class="prose panel">
      <slot />
    </div>

    <footer class="post-foot">
      <a href={`${base}/`} class="btn btn-ghost">◀ All posts</a>
      {frontmatter.tags && (
        <div class="tags">
          {frontmatter.tags.map((tag: string) => <span class="chip">#{tag}</span>)}
        </div>
      )}
    </footer>
  </article>
</BaseLayout>
