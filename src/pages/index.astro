---
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = await Astro.glob('./posts/*.md');
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout title="shkchan | Vibe Gaming & Pixel Art Studio">
  <!-- Vibe Gaming Banner -->
  <section class="nes-container is-dark with-title" style="margin-bottom: 2rem;">
    <p class="title pixel-font" style="color: #f7d51d;">WELCOME GAME VIBERS</p>

    <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
      <i class="nes-bcrikko" style="transform: scale(1.3);"></i>
      <div>
        <p style="margin-bottom: 0.5rem; line-height: 1.6;">
          Welcome! Here I share my <strong>Vibe Gaming</strong> experiences, retro game mechanics breakdowns, full-stack development notes, and C++/OpenCV image processing takeaways.
        </p>
        <span class="nes-badge"><span class="is-warning">Pixel Style</span></span>
        <span class="nes-badge"><span class="is-success">Cloudflare Pages</span></span>
        <span class="nes-badge"><span class="is-primary">Astro 4.0</span></span>
      </div>
    </div>
  </section>

  <!-- Article Section -->
  <h2 class="pixel-font" style="font-size: 1.1rem; color: #92cc41; margin-bottom: 1.5rem;">
    <i class="nes-icon trophy is-small"></i> Quest Log & Articles ({sortedPosts.length})
  </h2>

  <div class="posts-list">
    {sortedPosts.map((post) => (
      <div class="nes-container is-dark post-card">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
          <h3 style="margin-top: 0; font-size: 1.1rem; margin-bottom: 0.5rem;">
            <a href={post.url} style="color: #209cee; text-decoration: none;">
              {post.frontmatter.title}
            </a>
          </h3>
          <span style="font-size: 0.8rem; color: #888;" class="pixel-font">{post.frontmatter.date}</span>
        </div>
        
        {post.frontmatter.tags && (
          <div style="margin-bottom: 0.8rem;">
            {post.frontmatter.tags.map((tag: string) => (
              <span class="tag-badge">{tag}</span>
            ))}
          </div>
        )}
        
        <p style="font-size: 0.9rem; color: #ccc; margin-bottom: 1rem;">
          {post.frontmatter.description || post.frontmatter.excerpt || "Click to read full article..."}
        </p>

        <a href={post.url} class="nes-btn is-success" style="font-size: 0.75rem;">
          Read Entry >>
        </a>
      </div>
    ))}
  </div>
</BaseLayout>
