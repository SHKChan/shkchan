---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, groupBy, categoryUrl } from '../lib/posts';

const posts = await getPosts();
const categories = [...groupBy(posts, (post) => [post.data.category]).values()].sort(
  (a, b) => b.posts.length - a.posts.length || a.name.localeCompare(b.name),
);
---

<BaseLayout>
  <section class="hero panel">
    <span class="label">Player 1</span>
    <h1 class="pixel">Press <span class="accent">Start</span><span class="blink">_</span></h1>
    <p>
      Notes from the workbench: retro game mechanics, C++ desktop apps, real-time computer vision,
      and the full-stack plumbing that holds it all together.
    </p>
    {posts.length > 0 && (
      <div class="hero-stats pixel">
        <span><b>{posts.length}</b> {posts.length === 1 ? 'post' : 'posts'}</span>
        <span><b>{categories.length}</b> {categories.length === 1 ? 'category' : 'categories'}</span>
      </div>
    )}
    <p class="hero-cta">
      <a href="https://www.vibe-game.com/" class="btn">▶ Play my games</a>
    </p>
  </section>

  <h2 class="section-title pixel">
    Quest log
    <small>Newest first</small>
  </h2>

  {categories.length > 1 && (
    <nav class="filters" aria-label="Categories">
      {categories.map(({ name, posts }) => (
        <a href={categoryUrl(name)} class="chip">{name} <b>{posts.length}</b></a>
      ))}
    </nav>
  )}

  <PostList posts={posts} />
</BaseLayout>
