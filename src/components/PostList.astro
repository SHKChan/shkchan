---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length > 0 ? (
  <ul class="quest-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
) : (
  <div class="empty panel">
    <p class="pixel">No quests yet</p>
    <p>New posts show up here as soon as they are published.</p>
  </div>
)}
